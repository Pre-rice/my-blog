+// —— 与 md 对齐：行首 `>` 引用语法 ——
+// Typst 不识别行首 `>`（会当普通文本原样输出），这里在编译前把引用行的 `>` 替换为
+// PUA 私有区标记，让 HTML 后处理能精确识别并转为 <blockquote>。连续引用行并段、
+// 空行分段、多段并入同一块等语义与 md 完全一致。
+const QUOTE_TOKEN = "\u{E000}\u{E001}";
+
+// 源码级预处理：标记行首（允许前导空白）的 `>` / `> ` 为引用行。
+// 跳过块级数学（单独成行的 $）与 raw 块（```）内部，避免误伤 `>` 运算符。
+function preprocessTypstQuote(source) {
+    const lines = source.split("\n");
+    const out = [];
+    let inMath = false;
+    let inRaw = false;
+    for (const line of lines) {
+        const trimmed = line.trim();
+        if (trimmed === "$") {
+            inMath = !inMath;
+            out.push(line);
+            continue;
+        }
+        if (trimmed.startsWith("```")) {
+            inRaw = !inRaw;
+            out.push(line);
+            continue;
+        }
+        if (inMath || inRaw) {
+            out.push(line);
+            continue;
+        }
+        out.push(line.replace(/^(\s*)>\s?/, `$1${QUOTE_TOKEN}`));
+    }
+    return out.join("\n");
+}
