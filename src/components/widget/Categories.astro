---
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();

/** 同时显示的分类个数，超出的部分滚动查看。改这个数即可调整可见数量 */
const MAX_VISIBLE_CATEGORIES = 3;
/** 单个分类项高度（rem），对应 ButtonLink 的 h-10；改按钮高度时需同步改这里 */
const CATEGORY_ITEM_HEIGHT_REM = 2.5;
const COLLAPSED_HEIGHT = `${MAX_VISIBLE_CATEGORIES * CATEGORY_ITEM_HEIGHT_REM}rem`;
const COLLAPSE_THRESHOLD = 10;

const isCollapsed = categories.length >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name="分类" id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    <div class="category-scroll" style={`max-height: ${COLLAPSED_HEIGHT}`}>
        {categories.map((c) =>
            <ButtonLink
                url={c.url}
                badge={String(c.count)}
                label={`View all posts in the ${c.name.trim()} category`}
            >
                {c.name.trim()}
            </ButtonLink>
        )}
    </div>
</WidgetLayout>

<style>
    /* 滚动条样式与音乐播放列表一致（高度由 frontmatter 的 MAX_VISIBLE_CATEGORIES 决定，见内联 style） */
    .category-scroll {
        overflow-y: auto;
        padding-right: 6px;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--content-meta) 30%, transparent)
            transparent;
    }

    .category-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .category-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .category-scroll::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--content-meta) 30%, transparent);
        border-radius: 999px;
    }

    .category-scroll::-webkit-scrollbar-thumb:hover {
        background: color-mix(in srgb, var(--content-meta) 55%, transparent);
    }
</style>
