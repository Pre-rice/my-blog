---
import type { MarkdownHeading } from "astro";
import SidebarColumn from "./SidebarColumn.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings;
---

<SidebarColumn
	side="right"
	containerId="right-sidebar"
	stickyId="right-sidebar-sticky"
	rootClass={`${className ?? ""} w-full`}
	headings={headings}
/>
