---
import type { MarkdownHeading } from "astro";

import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

/** 有目录的页面（文章页）标签云最多显示的行数，超出的部分滚动查看。改这个数即可调整可见行数 */
const MAX_VISIBLE_TAG_ROWS = 5;
/** 单行标签高度（rem），对应 ButtonTag 的 h-8；行间距对应标签容器的 gap-2 */
const TAG_ROW_HEIGHT_REM = 2;
const TAG_ROW_GAP_REM = 0.5;
const MAX_HEIGHT = `${MAX_VISIBLE_TAG_ROWS * TAG_ROW_HEIGHT_REM + (MAX_VISIBLE_TAG_ROWS - 1) * TAG_ROW_GAP_REM}rem`;

interface Props {
	class?: string;
	style?: string;
	headings?: MarkdownHeading[];
}
const { headings } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

/** 有目录（文章页）→ 限高并显示滚动条；无目录页面（如主页）→ 完整展示 */
const hasHeadings = (headings ?? []).length > 0;
---
<WidgetLayout name="标签" id="tags" class={className} style={style}>
    <div
        class:list={["tag-scroll", { "tag-scroll-limited": hasHeadings }]}
        data-tag-scroll
        data-max-height={MAX_HEIGHT}
        style={hasHeadings ? `max-height: ${MAX_HEIGHT}` : undefined}
    >
        <div class="flex gap-2 flex-wrap" data-tag-cloud>
            {tags.map(t => (
                <ButtonTag href={getTagUrl(t.name)} label={`View all posts with the ${t.name.trim()} tag`}>
                    {t.name.trim()}
                </ButtonTag>
            ))}
        </div>
    </div>
</WidgetLayout>

<style>
    /* 滚动条样式与音乐播放列表、分类卡片一致；限高由 frontmatter 的 MAX_VISIBLE_TAG_ROWS 决定 */
    .tag-scroll {
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .tag-scroll-limited {
        padding-right: 6px;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--content-meta) 30%, transparent)
            transparent;
    }

    .tag-scroll-limited::-webkit-scrollbar {
        width: 6px;
    }

    .tag-scroll-limited::-webkit-scrollbar-track {
        background: transparent;
    }

    .tag-scroll-limited::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--content-meta) 30%, transparent);
        border-radius: 999px;
    }

    .tag-scroll-limited::-webkit-scrollbar-thumb:hover {
        background: color-mix(in srgb, var(--content-meta) 55%, transparent);
    }
</style>

<script>
	// 贪心装箱：行内放不下长标签时，用后面的短标签补足空隙，让标签云尽可能铺满
	function packTagCloud(container: HTMLElement) {
		const items = Array.from(container.children) as HTMLElement[];
		if (items.length <= 1) {
			return;
		}

		const gap = Number.parseFloat(getComputedStyle(container).columnGap) || 0;
		const width = container.clientWidth;
		if (width <= 0) {
			return;
		}

		const pending = items.map((el) => ({ el, w: el.offsetWidth }));
		const rows: HTMLElement[][] = [];
		let row: HTMLElement[] = [];
		let rowWidth = 0;

		while (pending.length > 0) {
			const first = pending[0];
			const needWidth = rowWidth === 0 ? first.w : rowWidth + gap + first.w;

			if (needWidth <= width) {
				// 当前行放得下，直接入行
				row.push(first.el);
				rowWidth = needWidth;
				pending.shift();
				continue;
			}

			if (row.length === 0) {
				// 单个标签也超宽（容器过窄），强制独占一行
				row.push(first.el);
				rowWidth = first.w;
				pending.shift();
				continue;
			}

			// 当前行放不下首标签：从后面找第一个能补进当前行的短标签
			const fitIndex = pending.findIndex(
				(p, i) => i > 0 && rowWidth + gap + p.w <= width,
			);
			if (fitIndex > 0) {
				const fit = pending.splice(fitIndex, 1)[0];
				row.push(fit.el);
				rowWidth += gap + fit.w;
			} else {
				// 没有能补的短标签，封行
				rows.push(row);
				row = [];
				rowWidth = 0;
			}
		}
		if (row.length > 0) {
			rows.push(row);
		}

		// 按重排后的顺序更新 DOM（appendChild 会按新顺序重新插入）
		for (const rowEls of rows) {
			for (const el of rowEls) {
				container.appendChild(el);
			}
		}
	}

	const container = document.querySelector<HTMLElement>("[data-tag-cloud]");
	if (container) {
		const pack = () => packTagCloud(container);
		// 等字体（含 emoji）就绪后再测量，避免宽度偏差
		if (document.fonts?.ready) {
			document.fonts.ready.then(pack);
		}
		// 容器宽度变化（窗口缩放等）时重新排列
		if ("ResizeObserver" in window) {
			const ro = new ResizeObserver(pack);
			ro.observe(container);
		}
	}
</script>

<script>
	// Swup 无刷新导航只替换 main 与 #toc，侧栏组件不会重新渲染，
	// 标签块「定位」与「是否限高」会停留在旧页面的状态。这里依据当前页面目录是否为空
	// （目录为空即非文章页）同步两件事：
	//   定位：非文章页（如主页）→ sticky 列，随页面下翻留住；文章页 → top 列，随滚动滚出视野
	//   限高：非文章页 → 完整展示；文章页 → 限高到 MAX_VISIBLE_TAG_ROWS 行并显示滚动条
	function syncTagsPosition() {
		const tagsEl = document.querySelector('widget-layout[data-id="tags"]');
		if (!tagsEl) return;
		const root = tagsEl.closest(".sidebar-column-root");
		if (!root) return;
		// 只依据标签块所在侧栏的目录状态判断（当前为左侧栏）
		const tocEmpty =
			root.querySelector(".toc-widget-card table-of-contents.empty") != null;
		const topCol = root.querySelector(".sidebar-top-column");
		const stickyCol = root.querySelector(".sidebar-sticky-column");
		if (!topCol || !stickyCol) return;

		if (tocEmpty) {
			if (tagsEl.parentElement !== stickyCol) {
				stickyCol.insertBefore(tagsEl, stickyCol.firstChild);
			}
		} else if (tagsEl.parentElement !== topCol) {
			topCol.appendChild(tagsEl);
		}

		const scroller = tagsEl.querySelector<HTMLElement>("[data-tag-scroll]");
		if (!scroller) return;
		if (tocEmpty) {
			scroller.style.removeProperty("max-height");
			scroller.classList.remove("tag-scroll-limited");
		} else {
			scroller.style.setProperty("max-height", scroller.dataset.maxHeight ?? "");
			scroller.classList.add("tag-scroll-limited");
		}
	}

	const setupTagsPositionSync = () => {
		// 首次加载时同步一次（此时 SSR 已就位，幂等）
		syncTagsPosition();
		window.swup.hooks.on("content:replace", syncTagsPosition);
		window.swup.hooks.on("page:view", syncTagsPosition);
	};
	if (window.swup) {
		setupTagsPositionSync();
	} else {
		document.addEventListener("swup:enable", setupTagsPositionSync);
	}
</script>
