---

import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---
<WidgetLayout name="标签" id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
    <div class="flex gap-2 flex-wrap" data-tag-cloud>
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name)} label={`View all posts with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>

<script>
	// 贪心装箱：行内放不下长标签时，用后面的短标签补足空隙，让标签云尽可能铺满
	function packTagCloud(container: HTMLElement) {
		const items = Array.from(container.children) as HTMLElement[];
		if (items.length <= 1) {
			return;
		}

		const gap = Number.parseFloat(getComputedStyle(container).columnGap) || 0;
		const width = container.clientWidth;
		if (width <= 0) {
			return;
		}

		const pending = items.map((el) => ({ el, w: el.offsetWidth }));
		const rows: HTMLElement[][] = [];
		let row: HTMLElement[] = [];
		let rowWidth = 0;

		while (pending.length > 0) {
			const first = pending[0];
			const needWidth = rowWidth === 0 ? first.w : rowWidth + gap + first.w;

			if (needWidth <= width) {
				// 当前行放得下，直接入行
				row.push(first.el);
				rowWidth = needWidth;
				pending.shift();
				continue;
			}

			if (row.length === 0) {
				// 单个标签也超宽（容器过窄），强制独占一行
				row.push(first.el);
				rowWidth = first.w;
				pending.shift();
				continue;
			}

			// 当前行放不下首标签：从后面找第一个能补进当前行的短标签
			const fitIndex = pending.findIndex(
				(p, i) => i > 0 && rowWidth + gap + p.w <= width,
			);
			if (fitIndex > 0) {
				const fit = pending.splice(fitIndex, 1)[0];
				row.push(fit.el);
				rowWidth += gap + fit.w;
			} else {
				// 没有能补的短标签，封行
				rows.push(row);
				row = [];
				rowWidth = 0;
			}
		}
		if (row.length > 0) {
			rows.push(row);
		}

		// 按重排后的顺序更新 DOM（appendChild 会按新顺序重新插入）
		for (const rowEls of rows) {
			for (const el of rowEls) {
				container.appendChild(el);
			}
		}
	}

	const container = document.querySelector<HTMLElement>("[data-tag-cloud]");
	if (container) {
		const pack = () => packTagCloud(container);
		// 等字体（含 emoji）就绪后再测量，避免宽度偏差
		if (document.fonts?.ready) {
			document.fonts.ready.then(pack);
		}
		// 容器宽度变化（窗口缩放等）时重新排列
		if ("ResizeObserver" in window) {
			const ro = new ResizeObserver(pack);
			ro.observe(container);
		}
	}
</script>

<script>
	// Swup 无刷新导航只替换 main 与 #toc，侧栏组件不会重新渲染，
	// 标签块「文章页 top / 非文章页 sticky」的定位会停留在旧页面的状态。
	// 这里依据当前页面目录是否为空（目录为空即非文章页），把标签块移到正确的列：
	// 非文章页（如主页）→ sticky 列，随页面下翻留住；文章页 → top 列，随滚动滚出视野。
	function syncTagsPosition() {
		const tagsEl = document.querySelector('widget-layout[data-id="tags"]');
		if (!tagsEl) return;
		const root = tagsEl.closest(".sidebar-column-root");
		if (!root) return;
		// 只依据标签块所在侧栏的目录状态判断（当前为左侧栏）
		const tocEmpty =
			root.querySelector(".toc-widget-card table-of-contents.empty") != null;
		const topCol = root.querySelector(".sidebar-top-column");
		const stickyCol = root.querySelector(".sidebar-sticky-column");
		if (!topCol || !stickyCol) return;

		if (tocEmpty) {
			if (tagsEl.parentElement !== stickyCol) {
				stickyCol.insertBefore(tagsEl, stickyCol.firstChild);
			}
		} else if (tagsEl.parentElement !== topCol) {
			topCol.appendChild(tagsEl);
		}
	}

	const setupTagsPositionSync = () => {
		// 首次加载时同步一次（此时 SSR 已就位，通常不移动，幂等）
		syncTagsPosition();
		window.swup.hooks.on("content:replace", syncTagsPosition);
		window.swup.hooks.on("page:view", syncTagsPosition);
	};
	if (window.swup) {
		setupTagsPositionSync();
	} else {
		document.addEventListener("swup:enable", setupTagsPositionSync);
	}
</script>