---
import { Icon } from "astro-icon/components";
---

<!-- 右下角浮动按钮组：返回主页（非主页且滚动时显示）+ 返回顶部 -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-home-btn" class="floating-btn hide" onclick="backToHome()">
        <button aria-label="返回主页" class="btn-card h-full w-full">
            <Icon name="material-symbols:home-outline-rounded" class="mx-auto"></Icon>
        </button>
    </div>
    <div id="back-to-top-btn" class="floating-btn hide" onclick="backToTop()">
        <button aria-label="返回顶部" class="btn-card h-full w-full">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    position: fixed
    right: 3rem     /* 水平位置，可按需微调 */
    bottom: 3rem      /* 垂直位置（越小越靠下），可按需微调 */
    z-index: 40
    width: 3rem
    height: 6.5rem
    pointer-events: none

.floating-btn
    color: var(--primary)
    font-size: 1.6rem
    font-weight: bold
    position: absolute
    right: 0
    width: 3rem
    height: 3rem
    opacity: 1
    cursor: pointer
    pointer-events: auto
    transition: opacity 0.3s ease, transform 0.3s ease
    border-radius: 1rem
    border: 1px solid rgba(148, 163, 184, 0.45)
    overflow: hidden

    svg
        font-size: 1.6rem

    &.hide
        opacity: 0
        pointer-events: none

    &:active
        transform: scale(0.9)

    &:first-child
        bottom: 3.5rem

    &:last-child
        bottom: 0

:global(.dark) .floating-btn
    border-color: rgba(255, 255, 255, 0.15)
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
function backToHome() {
    if (window.swup) {
        window.swup.navigate('/');
    } else {
        window.location.href = '/';
    }
}
</script>
